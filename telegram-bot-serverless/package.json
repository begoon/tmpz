{
  "name": "telegram-bot-serverless-example",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test --experimental-vm-modules",
    "cloud": "node --env-file-if-exists=.env scripts/cloud.js",
    "deploy": "npm run cloud -- push",
    "migrate": "npm run cloud -- migrate",
    "status": "npm run cloud -- status",
    "setup": "node --env-file=.env scripts/setup.js"
  },
  "devDependencies": { "@tgcloud/cli": "0.2.0" }
}
