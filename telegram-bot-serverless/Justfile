set positional-arguments

# Show available tasks.
default:
    @just --list

# Install the locked dependencies.
install:
    npm ci

# Initialize local Telegram CLI state (safe to rerun).
init:
    npm run cloud -- init

# Validate JavaScript syntax; Telegram deploys source without bundling.
build:
    npm run build

# Run handler and SQLite integration tests locally.
test:
    npm test

# Validate and test without contacting Telegram.
check: build test

# Deploy, apply safe migrations, sync the webhook, and register commands.
deploy: check
    npm run deploy
    npm run migrate -- --safe
    npm run cloud -- webhook sync
    npm run setup

# Upload code only, without migrating the database.
push:
    npm run deploy

# Preview pending database changes without applying them.
migrate-plan:
    npm run cloud -- migrate --dry-run

# Apply safe database changes only.
migrate:
    npm run migrate -- --safe

# Compare local modules with the last fetched/deployed snapshot.
status:
    npm run status

# Show local changes relative to the last snapshot.
diff:
    npm run cloud -- diff

# Refresh the cloud snapshot without modifying source files.
fetch:
    npm run cloud -- fetch

# Inspect webhook health.
webhook:
    npm run cloud -- webhook

# Repair the platform-managed webhook without dropping pending updates.
webhook-sync:
    npm run cloud -- webhook sync

# Register the command menu using BOT_TOKEN.
setup:
    npm run setup

# Check BOT_TOKEN without changing bot configuration.
bot-check:
    npm run setup -- --check

# Pass arguments through to tgcloud; quote JSON payloads as one argument.
cloud *args:
    npm run cloud -- "$@"
