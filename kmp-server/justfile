set quiet

# List recipes
default:
    just --list --unsorted

# Check formatting, then compile and assemble the server jar
build:
    ./gradlew ktfmtCheck assemble

# Reformat all Kotlin sources and build scripts with ktfmt
fmt:
    ./gradlew ktfmtFormat

# Check formatting without changing anything
fmt-check:
    ./gradlew ktfmtCheck

# Run the server (PORT env var overrides 8080)
serve:
    ./gradlew run

# Send a protobuf WebSocket ping (start the server first; PORT overrides 8080)
[positional-arguments]
ping message="hello" url="":
    ./gradlew --quiet ping "-PpingMessage=$1" "-PpingUrl=$2"

# Run endpoint tests
test:
    ./gradlew test

# Regenerate Kotlin and Java sources from proto/protocol.proto into src/main/generated
protobuf:
    rm -rf src/main/generated
    mkdir -p src/main/generated/java src/main/generated/kotlin
    bin/protoc --proto_path=proto \
        --java_out=src/main/generated/java \
        --kotlin_out=src/main/generated/kotlin \
        protocol.proto

# Download the htmx release pinned in gradle/libs.versions.toml into src/main/resources/assets/htmx
htmx:
    #!/usr/bin/env bash
    set -euo pipefail
    version="$(sed -nE 's/^htmx = "([^"]+)"/\1/p' gradle/libs.versions.toml)"
    mkdir -p src/main/resources/assets/htmx
    curl -fsSL -o src/main/resources/assets/htmx/htmx.min.js \
        "https://cdn.jsdelivr.net/npm/htmx.org@$version/dist/htmx.min.js"
    echo "htmx $version -> src/main/resources/assets/htmx/htmx.min.js"
    curl -fsSL -o src/main/resources/assets/htmx/hx-ws.min.js \
        "https://cdn.jsdelivr.net/npm/htmx.org@$version/dist/ext/hx-ws.min.js"
    echo "hx-ws $version -> src/main/resources/assets/htmx/hx-ws.min.js"

# Stop Gradle daemons and remove all local build output and caches
clean:
    -./gradlew --stop
    rm -rf build .gradle .kotlin .tools

image := "kmp-server"

# Build the Docker image
docker-build:
    docker build -t {{image}} .

# Run the Docker image (PORT env var overrides 8080 on the host side)
docker-run port=env('PORT', '8080'):
    docker run --rm -it --env-file .env -p {{port}}:8080 {{image}}
