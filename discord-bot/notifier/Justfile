project := "discord-bot"
project_id := "prj_mzwfJCDfYAYhAsBsbrBUEVrGjMsG"
production_url := "https://discord-responder.vercel.app"

# List available commands.
default:
    @just --list

# Install dependencies using the committed lockfile.
install:
    bun install --frozen-lockfile

# Run the HTTP service locally with automatic reload.
dev:
    bun run dev

# Run the Discord bot locally (stop production first to avoid duplicate replies).
bot:
    bun run bot

# List global Discord commands and their options.
commands-global:
    bun --env-file=.env scripts/list-commands.ts global

# List Discord commands and their options in the configured server.
commands-server:
    bun --env-file=.env scripts/list-commands.ts server

# Post to #general; defaults to "ok". Quote messages containing spaces.
[positional-arguments]
send-message message="ok":
    bun --env-file=.env scripts/send-message.ts "$1"

# Post through the messenger webhook; defaults to "ok".
[positional-arguments]
webhook-msg message="ok":
    bun --env-file=.env scripts/webhook-message.ts "$1"

# Run behavior tests and TypeScript checks.
check:
    bun test
    bun run typecheck

# Link this directory to the existing Vercel project.
link:
    vercel link --project {{project}}

# Deploy to production after checks; also rolls out the daemon.
deploy: check
    vercel deploy --prod

# Check the public HTTP service, not the Discord connection.
health:
    curl --fail --silent --show-error --max-time 20 {{production_url}}/health

# Show production daemon readiness and instance counts (Vercel beta API).
status:
    vercel api /v1/projects/{{project_id}}/daemons

# Show recent HTTP logs; daemon logs are available in the dashboard.
logs:
    vercel logs --project {{project}} --environment production --since 1h

# Print the dashboard URL for daemon logs and scaling controls.
dashboard:
    @echo "https://vercel.com/me-default/{{project}}"
